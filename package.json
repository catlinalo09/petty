{
  "name": "petty-fullstack",
  "version": "1.0.0",
  "private": true,
  "description": "Petty - tienda de delicias para mascotas (React + Express + MongoDB)",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "seed": "npm run seed --workspace server",
    "build": "npm run build --workspace client",
    "start": "npm start --workspace server",
    "start:prod": "cross-env NODE_ENV=production npm start --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
