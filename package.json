{
  "name": "petty-fullstack",
  "version": "1.0.0",
  "private": true,
  "description": "Petty - tienda de delicias para mascotas (React + Express + MongoDB)",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "seed": "npm run seed --workspace backend",
    "build": "npm run build --workspace frontend",
    "start": "npm start --workspace backend",
    "start:prod": "cross-env NODE_ENV=production npm start --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3"
  },
  "dependencies": {
    "serverless-http": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
